# CVX Panel environment configuration.
# Copy to .env (root) or apps/api/.env and fill in real values.

# --- Core ---
CVX_ENVIRONMENT=production            # development | staging | production
CVX_PUBLIC_BASE_URL=https://cvx.example.com

# --- Security (REQUIRED in production) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CVX_SECRET_KEY=change-me
CVX_SESSION_COOKIE_SECURE=true        # false only for plain-HTTP local dev

# --- Database ---
CVX_DB_USER=cvx
CVX_DB_PASSWORD=change-me
CVX_DB_NAME=cvx
# Full URL override (takes precedence for the API app):
# CVX_DATABASE_URL=postgresql+asyncpg://cvx:password@localhost:5432/cvx

# --- Redis ---
# CVX_REDIS_URL=redis://localhost:6379/0

# --- First-run owner account (created only when the users table is empty) ---
CVX_BOOTSTRAP_OWNER_EMAIL=admin@example.com
CVX_BOOTSTRAP_OWNER_PASSWORD=change-me-min-10-chars

# --- Agent enrollment ---
# Where nodes download the agent install script (shown in the add-node wizard).
# CVX_AGENT_INSTALL_URL=https://cvx.example.com/cvx-install.sh

# --- Docker compose port mapping ---
CVX_HTTP_PORT=80
